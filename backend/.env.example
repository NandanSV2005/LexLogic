# LexLogic Backend Environment Configuration
PROJECT_NAME="LexLogic API"
VERSION="0.1.0"
API_V1_STR="/api"
ENVIRONMENT="development" # Set to "production" in live deployment

# Security & JWT Configuration
# Required in production! Never use default keys in production.
JWT_SECRET_KEY="replace-with-a-secure-random-production-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (Render Persistent Disk: /var/data/lexlogic.db)
DATABASE_PATH="/var/data/lexlogic.db"
# Or explicitly: DATABASE_URL="sqlite:////var/data/lexlogic.db"

# Private Upload Storage Directory (Render Persistent Disk: /var/data/private_uploads)
PRIVATE_UPLOAD_DIR="/var/data/private_uploads"

# CORS Configuration (Comma-separated origins or JSON array)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://your-vercel-domain.vercel.app"

